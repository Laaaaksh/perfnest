# Copy to .env and fill in before running `docker compose up` or `npm run dev`.

# Postgres connection string. docker-compose.yml already points this at its
# own `db` service - only change it if you're running Postgres yourself.
DATABASE_URL=postgresql://perfnest:perfnest@localhost:5432/perfnest

# The single admin password for this instance. Perfnest has no user
# accounts - anyone with this password can manage every project.
ADMIN_PASSWORD=change-me

# Random string (32+ chars) used to sign session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=change-me-to-a-random-32-plus-character-string

# The public URL this instance is reachable at. Used to build links in
# alert messages and the CI curl example. Defaults to localhost for local
# development.
PUBLIC_BASE_URL=http://localhost:3000

# Optional: SMTP settings for the "email" alert channel type. Leave unset if
# you only use Slack/webhook alerts - Perfnest does not bundle an email
# provider, so email alerts need your own SMTP relay (Postmark, SES, your
# ISP's relay, etc).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=
